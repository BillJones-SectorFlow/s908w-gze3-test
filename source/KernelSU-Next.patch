+/// Stage Next's copy before the module changes the loader's security domain.
+/// Refuse to replace another installation during this experimental test.
+pub fn stage_s908w_daemon() -> Result<()> {
+    ensure_dir_exists(defs::ADB_DIR)?;
+    set_permissions(defs::ADB_DIR, Permissions::from_mode(0o700))?;
+    let expected = std::fs::read("/proc/self/exe")?;
+    let staged = std::fs::read("/data/local/tmp/.ksud-stage")
+        .context("Next's staged ksud is missing")?;
+    anyhow::ensure!(expected == staged, "Next's staged ksud differs from this loader");
+    if Path::new(defs::DAEMON_PATH).exists() {
+        anyhow::ensure!(
+            std::fs::read(defs::DAEMON_PATH)? == expected,
+            "another /data/adb/ksud exists; refusing to overwrite it"
+        );
+        return Ok(());
+    }
+    let temporary = Path::new(defs::ADB_DIR).join(".ksud-s908w-stage");
+    std::fs::write(&temporary, &expected)?;
+    set_permissions(&temporary, Permissions::from_mode(0o755))?;
+    std::fs::rename(&temporary, defs::DAEMON_PATH)?;
+    Ok(())
+}
+
+pub fn finish_s908w_install() -> Result<()> {
+    restorecon::lsetfilecon(defs::DAEMON_PATH, restorecon::KSU_CON)?;
+    assets::ensure_binaries(false).with_context(|| "Failed to extract assets")?;
+    link_ksud_to_bin()?;
+    Ok(())
+}
+
 pub fn install(libadbroot: Option<PathBuf>) -> Result<()> {
     ensure_dir_exists(defs::ADB_DIR)?;
     let _ = std::fs::remove_file(defs::DAEMON_PATH);
