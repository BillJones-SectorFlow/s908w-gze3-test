+#[cfg(test)]
+mod s908w_metadata_tests {
+    use super::*;
+
+    #[test]
+    fn rewriting_the_release_preserves_every_other_section() {
+        let original = include_bytes!("../tests/fixtures/samsung-5.10.ko");
+        let before = Elf::parse(original).unwrap();
+        let mut rewritten = original.to_vec();
+        let release = "5.10.236-android12-9-31998796-abS908WVLSAGZE3 SMP preempt mod_unload modversions aarch64";
+        replace_module_vermagic(&mut rewritten, release).unwrap();
+        let after = Elf::parse(&rewritten).unwrap();
+        assert_eq!(before.section_headers.len(), after.section_headers.len());
+        for (old, new) in before.section_headers.iter().zip(&after.section_headers) {
+            let name = before.shdr_strtab.get_at(old.sh_name).unwrap_or("");
+            assert_eq!(name, after.shdr_strtab.get_at(new.sh_name).unwrap_or(""));
+            if name == ".modinfo" {
+                let info = &rewritten[new.sh_offset as usize..(new.sh_offset + new.sh_size) as usize];
+                assert!(info.split(|b| *b == 0).any(|e| e == format!("vermagic={release}").as_bytes()));
+                assert!(info.split(|b| *b == 0).any(|e| e == b"name=kernelsu"));
+            } else {
+                assert_eq!(old.sh_offset, new.sh_offset, "{name}");
+                assert_eq!(old.sh_size, new.sh_size, "{name}");
+                if old.sh_type != section_header::SHT_NOBITS {
+                    let start = old.sh_offset as usize;
+                    let end = start + old.sh_size as usize;
+                    assert_eq!(&original[start..end], &rewritten[start..end], "{name}");
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn malformed_module_is_rejected_without_mutating_it() {
+        let original = b"not a kernel module".to_vec();
+        let mut buffer = original.clone();
+        assert!(replace_module_vermagic(&mut buffer, "invalid").is_err());
+        assert_eq!(buffer, original);
+    }
+}
