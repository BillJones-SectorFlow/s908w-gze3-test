--- a/src/preload.c
+++ b/src/preload.c
@@ -1,4 +1,6 @@
 #include "common.h"
+#include <sys/utsname.h>
+#include <sys/system_properties.h>
 
 #define DEFAULT_EXPLOIT_ATTEMPTS 16
 #define DEFAULT_PSELECT_DELAY_USEC 20000
@@ -35,8 +37,42 @@ __attribute__((constructor)) static void load(void) {
   started = 1;
   set_unbuffer();
 
+  /* This experimental port deliberately supports only the verified stock
+   * kernel and shell transport. Refuse before entering the kernel race. */
+  struct utsname running;
+  char model[PROP_VALUE_MAX] = {0};
+  __system_property_get("ro.product.model", model);
+  if (uname(&running) != 0 || strcmp(model, "SM-S908W") != 0 ||
+      strcmp(running.release,
+             "5.10.236-android12-9-31998796-abS908WVLSAGZE3") != 0) {
+    pr_error("rmgnext: this payload requires SM-S908W S908WVLSAGZE3 exactly\n");
+    _exit(64);
+  }
+  if (getuid() != 2000 || geteuid() != 2000) {
+    pr_error("rmgnext: shell UID 2000 required; enable and authorize Shizuku\n");
+    _exit(65);
+  }
+  const char *helper = getenv("CVE43499_ROOT_HELPER");
+  if (!helper || helper[0] != '/' || strlen(helper) >= 256 ||
+      access(helper, X_OK) != 0) {
+    pr_error("rmgnext: Next bootstrap helper missing or not executable\n");
+    _exit(66);
+  }
+  const char *route = getenv("SLIDE_SOURCE");
+  if (route && strcmp(route, "tracefs") != 0 &&
+      strcmp(route, "auto") != 0 && strcmp(route, "default") != 0) {
+    pr_error("rmgnext: this port supports tracefs only; select tracefs route\n");
+    _exit(67);
+  }
+  unsetenv("SLIDE_P0_OFFSET");
+  pr_info("rmgnext: experimental S908WVLSAGZE3 shell port v1; helper=%s\n", helper);
+
   int max_attempts = env_int(
       "EXPLOIT_ATTEMPTS", DEFAULT_EXPLOIT_ATTEMPTS, 1, 64);
+  if (max_attempts > 1) {
+    pr_info("rmgnext: first-test build caps this run at one native attempt; reboot before another test\n");
+    max_attempts = 1;
+  }
   int base_delay = env_int(
       "PSELECT_DELAY_USEC", DEFAULT_PSELECT_DELAY_USEC, 0, 1000000);
   if (getenv("SLIDE_ONLY")) {
